# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files to be normalized
*.rs text
*.toml text
*.md text
*.txt text
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.gif binary
*.pdf binary

# Test fixtures keep LF endings
tests/fixtures/** text eol=lf
tests/fixtures/mustgo/real/** -text
tests/fixtures/xdock/real/** -text
tests/fixtures/toyota/real/** -text
tests/fixtures/misc/real/** -text
tests/fixtures/k2xx/real/** -text
tests/fixtures/relabel/real/** -text
tests/fixtures/mm60/** -text
tests/fixtures/repack/real/** -text
