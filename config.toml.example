[build]
target = "i686-pc-windows-msvc"

[global]
instance_id = "ES1"
reports_dir = "C:\\temp\\reports"
default_tcode = "VT11"
timezone = "MST"
# 0 = unconverted or text with tabs
# 1 = text with tabs
# 2 = rich text format
# 3 = HTML format
# 4 = clipboard - no file
# excel = excel file (menu option differs for each tcode)
default_export_type = 0

[tcode.VT11]
variant = "testing_7"
layout = "my_layout"
date_range_start = "01/01/2023"
date_range_end = "12/31/2023"
by_date = "true"
by_delivery = "false"

[tcode.ZVT11]
variant = "variantname"
layout = "layoutname"
by_delivery = "true"
export_type = 0

[tcode.VL06O]
variant = "delivery_layout"
layout = "delivery_view"
column_name = "Shipment Number"

[tcode.ZMDESNR]
variant = "ZMDESNR_VARIANT"
layout = "MY_LAYOUT"
# Example: specify the columns to use for the layout
layout_columns = [
  "Serial #",
  "Status",
  "Customer Name",
  "Storage Bin",
  "Material Number",
  "Qty",
  "Shipment Number",
  "Time"
]
tab_number = "2"
serial_number = "SN12345"
pre_export_back = true

[tcode.LX03]
variant = "your_variant"
layout = "LX03_LAYOUT"
export_type = 1

# MM60 reads the material list of the newest LX03 export (plants are NOT copied; the plant
# selection is cleared). Layout/variant/export_type apply to MM60 only.
[tcode.MM60]
variant = "your_mm60_variant"
layout = "MM60_LAYOUT"
export_type = 1
# lx03_file = "lx03"   # slug under reports_dir, or a path; default: newest file in the LX03 export dir

[tcode.y_dn3_47000149]
variant = "variant_name"
layout = "LAYOUT_149"
plants = [
  "PLANT_A",
  "PLANT_B",
  "PLANT_C"
]
mat_variant = "VARIANT_149_MATERIAL"
149_days_range = 5
export_type = 0
rcv_variant = "VARIANT_149_RCV"
rcv_days_back = 1
rcv_layout = "rcv_layoutname"

# Inbond clerk flow: shipment → VL06O → 149 (INB_149_NAME) → paste-ready txt + Notepad
# Used by menu "Inbond - Shipment to 149". Does not use exec_rest.
[inbond]
vl06o_variant = "blank_"
variant_149 = "INB_149_NAME"
layout_149 = "INB_149_NAME"
# Used when layout_149 is missing or not found in SAP (Change Layout setup)
layout_columns = [
  "Plant",
  "Delivery Number",
  "Material",
  "Quantity",
  "UOM",
  "Logistics Reference Number"
]
export_type = 1
open_notepad = true

[loop]
tcode = "VT11"
iterations = "4"
delay_seconds = "15"
param_list_header = "Shipment Number"
param_set_field = "date"
param_set_value = ""

# ---------------------------------------------------------------------------
# ABC headless reports (--rname=...). All names below are PLACEHOLDERS: put the real SAP
# variant/layout names, plant codes and customer patterns of your site in config.toml
# (git-ignored). Every key is optional; the built-in defaults are the same placeholders.
# ---------------------------------------------------------------------------
[abc.mustgo]
vt11_variant = "VT11_XDOCK_VARIANT"
zmdesnr_variant = "ZMDESNR_MUSTGO_VARIANT"
zmdesnr_layout = "ZMDESNR_MUSTGO_LAYOUT"
lt23_layout = "LT23_MUSTGO_LAYOUT"
warehouse = "WH01"

[abc.xdock]
vt11_variant = "VT11_XDOCK_VARIANT"
vt11_layout = "VT11_LAYOUT"
vl06o_layout = "VL06O_XDOCK_LAYOUT"
zmdetpc_variant = "ZMDETPC_VARIANT"

[abc.toyota]                      # same keys as [abc.xdock]; only the VT11 variant differs by default
vt11_variant = "VT11_TOYOTA_VARIANT"

[abc.misc]
vt11_variant = "VT11_MISC_VARIANT"
vt11_layout = "VT11_LAYOUT"
vl06o_layout = "VL06O_INV_LAYOUT"
ship_point_marker = "PLACEHOLDER_SP"   # shipping points containing this text are replaced by the ship-to "(...)" part

[abc.k2xx]
vt11_variant = "VT11_K2XX_VARIANT"
vt11_layout = "VT11_LAYOUT"
vl06o_variant = ""                 # optional; empty = no variant
vl06o_layout = "VL06O_K2XX_LAYOUT"
zvt11_variant = "ZVT11_K2XX_VARIANT"
zvt11_layout = "ZVT11_K2XX_LAYOUT"
zmdetpc_variant = "ZMDETPC_VARIANT"

[abc.relabel]
zmdesnr_variant = "ZMDESNR_RELABEL_VARIANT"
zmdesnr_layout = "ZMDESNR_RELABEL_LAYOUT"
label_plant = "PL55"                # plant of the label rows
alias_plant = "AL55"                # label_plant rows of an alias customer count as this plant
alias_customers = ["ALIAS_A*", "ALIAS_B*", "ALIAS_C*"]

[abc.repack]                        # needs the k2xx and relabel output of the same run
zmdesnr_variant = "ZMDESNR_REPACK_VARIANT"
zmdesnr_layout = "ZMDESNR_REPACK_LAYOUT"
label_plant = "PL55"                # same keys as [abc.relabel]
alias_plant = "AL55"
alias_customers = ["ALIAS_A*", "ALIAS_B*", "ALIAS_C*"]
history_warehouse = "WH01"          # History rows of this warehouse number (status UNP) are kept

[abc.manual_to]                     # `--tcode lt03`: shipments -> VL06O -> ZMDESNR by material -> LT03 per delivery
vl06o_variant = "MANUAL_TO_VL06O_VARIANT"
vl06o_layout = "MANUAL_TO_VL06O_LAYOUT"
zmdesnr_variant = "MANUAL_TO_ZMDESNR_VARIANT"
zmdesnr_layout = "MANUAL_TO_ZMDESNR_LAYOUT"
warehouse = "WH01"                  # LT03 warehouse number (LTAK-LGNUM)
bin_pick_strategy = "fifo"          # fifo (default) | lifo | load_balance | sequential
age_cutoff = 30                     # max GR age in days of a bin (fifo/lifo only, 0 = off)
allow_relabel = true                # may use bins of other ship-tos when the ship-to's bins are short
skip_blacklist = true               # apply the blocked-stock rules of the ZMDESNR export
blacklist_material_policy = "allow_material_skip_bins"   # default; or skip_if_any (skip the whole material)
shipto_strategy = "first"           # ship-to of a delivery with several: first | majority
proceed_without_gr = true           # fifo/lifo with bins without GR date: continue sequentially (never asks)
sap_date_format = "yyyy-mm-dd"      # format of the GR date column (default: [global] date_format)
# material_col / bin_col / qty_col / shipto_col / blocked_col: header names of the ZMDESNR export
